# Archive deliverables default to Git LFS.
**/*.html filter=lfs diff=lfs merge=lfs -text
**/*.htm filter=lfs diff=lfs merge=lfs -text
**/*.pptx filter=lfs diff=lfs merge=lfs -text

# The standalone repository index remains reviewable in regular Git.
/index.html -filter diff merge text

# Keep report notes reviewable in regular Git.
*.md -filter diff merge text
*.markdown -filter diff merge text
