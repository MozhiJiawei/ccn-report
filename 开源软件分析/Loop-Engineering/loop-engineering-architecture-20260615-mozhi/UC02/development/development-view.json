{
  "view": "development",
  "title": "Loop Engineering UC02 开发视图",
  "summary": "围绕 UC02「执行 Loop」抽取的开发视图中间模型：从 pattern registry 出发，经脚手架与多工具运行面接线，落到 GitHub Actions harness，以及 state/budget/run-log/verifier 支撑契约。",
  "description": "该仓库并没有一个统一常驻的 loop runtime。开发者维护的是一组可复用模式元数据、copyable starter、按工具改写的运行面示例、可插入 CI 的 automation harness，以及约束 loop 持续运行的状态与门禁契约。",
  "scope": "只解释 UC02 的实现切片：patterns/registry、starters、examples/grok、examples/claude-code、examples/codex、examples/github-actions，以及 loop-init、loop-audit、loop-cost、loop-budget、loop-verifier 等共享支撑。省略 docs 站点、stories、web-captures、assets、dist 和运行期生成物。",
  "style_profile": "ref-default",
  "layout_suggestion": {
    "strategy": "layered-groups"
  },
  "build_roots": [
    {
      "id": "repo-root",
      "paths": [
        "package.json",
        "scripts/"
      ],
      "reason": "主仓脚本负责校验 registry、一致性检查，以及串起 tools 的构建与测试。"
    },
    {
      "id": "pattern-root",
      "paths": [
        "patterns/"
      ],
      "reason": "模式注册表是 UC02 的业务源头，定义可运行 loop 的 cadence、skills、state、starter 与 cost。"
    },
    {
      "id": "starter-root",
      "paths": [
        "starters/",
        "templates/"
      ],
      "reason": "starter 与模板资产承载不同工具面的复制入口和状态/技能骨架。"
    },
    {
      "id": "example-root",
      "paths": [
        "examples/grok/",
        "examples/claude-code/",
        "examples/codex/",
        "examples/github-actions/"
      ],
      "reason": "examples 把同一模式和状态契约映射到不同调度与调用面。"
    },
    {
      "id": "tool-roots",
      "paths": [
        "tools/loop-init/",
        "tools/loop-audit/",
        "tools/loop-cost/"
      ],
      "reason": "三个 npm CLI 分别负责脚手架、readiness 审计与成本估算。"
    }
  ],
  "module_dependencies": [
    {
      "source": "loop-init-cli",
      "target": "pattern-registry",
      "dependency_type": "read-time",
      "reason": "CLI 读取 pattern id、state 文件和预算常量，并通过同步脚本校验覆盖全部 registry 模式。"
    },
    {
      "source": "loop-init-cli",
      "target": "starter-assets",
      "dependency_type": "packaged-assets",
      "reason": "发布包直接捆绑 starters 与 templates，scaffold 时复制到目标仓库。"
    },
    {
      "source": "runtime-surface-examples",
      "target": "loop-control-contract",
      "dependency_type": "shared-contract",
      "reason": "Grok、Claude、Codex 只改变调度与 prompt 表达，仍共享 STATE、worktree、verifier 与 budget guard 契约。"
    },
    {
      "source": "automation-harness",
      "target": "runtime-surface-examples",
      "dependency_type": "semantic-alignment",
      "reason": "GitHub Actions 复用同一 triage 语义与状态 schema，只把交互式 `/loop` 换成 workflow trigger + Invoke agent。"
    },
    {
      "source": "audit-cost-tooling",
      "target": "pattern-registry",
      "dependency_type": "metadata-consumer",
      "reason": "loop-cost 打包 registry 为 registry.json；loop-audit 把 registry 是否存在视为 readiness 信号。"
    },
    {
      "source": "audit-cost-tooling",
      "target": "loop-control-contract",
      "dependency_type": "policy-check",
      "reason": "loop-audit 与 loop-cost 共同消费 budget、run-log、verifier 与 LOOP/STATE 约束。"
    }
  ],
  "ownership_notes": [
    {
      "module": "pattern-registry",
      "note": "这里是 UC02 的单一模式语义源；改 cadence、skills、starter 或 token cost 时，应同步检查 examples 与 tools。"
    },
    {
      "module": "starter-assets",
      "note": "starter 代表开发者复制进外部项目的骨架，不应把复制后产生的具体项目状态或日志回灌成仓库源码模块。"
    },
    {
      "module": "loop-control-contract",
      "note": "状态、预算、run-log 和 verifier 是跨工具共享契约，不属于 Grok、Claude、Codex 任一单独 runtime。"
    },
    {
      "module": "automation-harness",
      "note": "GitHub Actions 只提供触发和上下文收集壳层，真正的 agent 实现故意留在 Invoke agent 接线点。"
    }
  ],
  "groups": [
    {
      "id": "pattern-source",
      "label": "模式源层",
      "color_role": "orange",
      "layout_hint": {
        "order": 1
      }
    },
    {
      "id": "scaffold",
      "label": "脚手架装配层",
      "color_role": "blue",
      "layout_hint": {
        "order": 2
      }
    },
    {
      "id": "runtime-wiring",
      "label": "运行面接线层",
      "color_role": "green",
      "layout_hint": {
        "order": 3
      }
    },
    {
      "id": "loop-contract",
      "label": "状态与门禁层",
      "color_role": "purple",
      "layout_hint": {
        "order": 4
      }
    },
    {
      "id": "assurance",
      "label": "审计估算层",
      "color_role": "red",
      "layout_hint": {
        "order": 5
      }
    }
  ],
  "elements": [
    {
      "id": "pattern-registry",
      "label": "Pattern Registry",
      "type": "subsystem",
      "group": "pattern-source",
