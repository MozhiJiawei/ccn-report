  "primary_paths": [
    {
      "id": "path-pr-babysitter-codex",
      "label": "Codex PR Babysitter tick",
      "summary": "Codex Automations 每次 tick 只起一个主 Agent run；主 run 先读 state 与 GitHub，再用 triage 判断是否允许修复。命中 minimal-fix 条件时才打开 worktree，派 implementer 与 verifier；无论通过、拒绝还是高风险，都只评论、回写状态、交给人工。",
      "entrypoint": "examples/codex/pr-babysitter.md:13-22",
      "participant_order": [
        "codex-automation",
        "main-agent-run",
        "state-ledger",
        "github-pr-surface",
        "triage-skill",
        "worktree",
        "implementer",
        "verifier",
        "pr-comment",
        "human-gate"
      ],
      "main_step_ids": [
        "rel-auto-main",
        "rel-main-state-read",
        "rel-main-github-read",
        "rel-main-triage",
        "rel-triage-main-fix",
        "rel-main-worktree",
        "rel-worktree-implementer",
        "rel-implementer-verifier",
        "rel-verifier-main-approve",
        "rel-main-comment-proposal",
        "rel-main-state-write",
        "rel-comment-human"
      ],
      "branches": [
        {
          "label": "高风险或达上限",
          "when": "attempts >= 3，或 triage 命中高风险 labels / human gates 时，主 run 不开 worktree，直接升级。",
          "step_ids": [
            "rel-triage-main-escalate",
            "rel-main-comment-escalate",
            "rel-main-state-write",
            "rel-comment-human"
          ]
        },
        {
          "label": "verifier 拒绝",
          "when": "verifier 输出 REJECT 或 ESCALATE_HUMAN 时，主 run 不自动 merge，只回评论与状态并交还人工。",
          "step_ids": [
            "rel-verifier-main-reject",
            "rel-main-comment-escalate",
            "rel-main-state-write",
            "rel-comment-human"
          ]
        }
      ]
    }
  ],
